   1:services/crypto/jitter_rng.c **** #include "jitter_rng.h"
   2:services/crypto/jitter_rng.c **** #include "stm32f0xx.h"
   3:services/crypto/jitter_rng.c **** #include "../../Core/Inc/aes.h"     /* aes128_encrypt_block (conditioner) */
   4:services/crypto/jitter_rng.c **** 
   5:services/crypto/jitter_rng.c **** /*
   6:services/crypto/jitter_rng.c ****  * jitter_rng.c: two-oscillator timing-jitter entropy source, STM32F042
   7:services/crypto/jitter_rng.c ****  *
   8:services/crypto/jitter_rng.c ****  * Two independent clocks
   9:services/crypto/jitter_rng.c ****  * ----------------------
  10:services/crypto/jitter_rng.c ****  *   Clock A: system clock, HSE crystal -> PLL -> 48 MHz (set up by clock_48mhz_init
  11:services/crypto/jitter_rng.c ****  *            unless the PLL is already the system clock). Drives TIM14's counter.
  12:services/crypto/jitter_rng.c ****  *   Clock B: LSI, the internal ~40 kHz RC oscillator. Routed to TIM14 channel 1
  13:services/crypto/jitter_rng.c ****  *            through the RTC clock mux (RTCSEL = LSI) and TIM14_OR.TI1_RMP.
  14:services/crypto/jitter_rng.c ****  *
  15:services/crypto/jitter_rng.c ****  * Every rising LSI edge latches the TIM14 count into CCR1. The difference
  16:services/crypto/jitter_rng.c ****  * between two captures is the number of 48 MHz ticks in one LSI period
  17:services/crypto/jitter_rng.c ****  * (about 1200). The two oscillators have no phase relationship, so the low bits of
  18:services/crypto/jitter_rng.c ****  * that difference move with LSI period jitter and wander.
  19:services/crypto/jitter_rng.c ****  *
  20:services/crypto/jitter_rng.c ****  * Caveat: if the LSI/HSE frequency ratio were perfectly stable, the low bits
  21:services/crypto/jitter_rng.c ****  * would still follow a deterministic pattern (like a Bresenham line). Only the
  22:services/crypto/jitter_rng.c ****  * real jitter perturbs it, which is why the entropy MUST be measured
  23:services/crypto/jitter_rng.c ****  * (jitter_rng_raw + ea_non_iid) and why the assumed entropy below is low.
  24:services/crypto/jitter_rng.c ****  *
  25:services/crypto/jitter_rng.c ****  * Pipeline: capture -> delta -> low 2 bits -> health tests (RCT + APT)
  26:services/crypto/jitter_rng.c ****  *           -> pack -> AES-CBC-MAC compression -> 16 output bytes.
  27:services/crypto/jitter_rng.c ****  *
  28:services/crypto/jitter_rng.c ****  * Startup: plausibility self-test, then SP 800-90B startup health tests
  29:services/crypto/jitter_rng.c ****  *          (1024 samples through RCT + APT, no output).
  30:services/crypto/jitter_rng.c ****  */
  31:services/crypto/jitter_rng.c **** 
  32:services/crypto/jitter_rng.c **** /* ---- configuration: replace the placeholders after measuring ---------- */
  33:services/crypto/jitter_rng.c **** #define JITTER_ASSUMED_H          0.125   /* PLACEHOLDER: min-entropy, bits per 2-bit symbol   */
ARM GAS  /var/folders/z2/mjhqlg9j11s2j1dlk0c67xh40000gn/T//ccnO7ZWe.s 			page 2


  34:services/crypto/jitter_rng.c **** #define JITTER_SAMPLES_PER_BLOCK  4096u   /* 4096 x 0.125 = 512 bits in -> 128 bits out (4x)    */
  35:services/crypto/jitter_rng.c **** #define JITTER_RCT_CUTOFF         161u    /* 1 + ceil(20 / H), alpha = 2^-20                    */
  36:services/crypto/jitter_rng.c **** #define JITTER_APT_WINDOW         512u    /* SP 800-90B window for non-binary symbols           */
  37:services/crypto/jitter_rng.c **** #define JITTER_APT_CUTOFF         497u    /* 1 + CRITBINOM(512, 2^-H, 1 - 2^-20)                */
  38:services/crypto/jitter_rng.c **** #define JITTER_SYMBOL_MASK        0x03u   /* keep 2 bits per sample (packing below assumes 2)   */
  39:services/crypto/jitter_rng.c **** #define JITTER_STARTUP_SAMPLES    1024u   /* SP 800-90B 4.3: startup test length                */
  40:services/crypto/jitter_rng.c **** 
  41:services/crypto/jitter_rng.c **** #define JITTER_CLK_SPINS          200000u /* timeout for HSE / PLL / switch waits               */
  42:services/crypto/jitter_rng.c **** #define JITTER_PLL_MUL            RCC_CFGR_PLLMUL6   /* 8 MHz HSE x 6 = 48 MHz (Red Pill crystal) *
  43:services/crypto/jitter_rng.c **** 
  44:services/crypto/jitter_rng.c **** #define JITTER_TIMEOUT_SPINS      20000u  /* >> one LSI period (25 us ~ 200 loop passes)        */
  45:services/crypto/jitter_rng.c **** #define JITTER_LSI_START_SPINS    100000u
  46:services/crypto/jitter_rng.c **** #define JITTER_DELTA_MIN          400u    /* self-test window for the 48 MHz count per LSI      */
  47:services/crypto/jitter_rng.c **** #define JITTER_DELTA_MAX          3200u   /* period (LSI 30..60 kHz is 800..1600)               */
  48:services/crypto/jitter_rng.c **** 
