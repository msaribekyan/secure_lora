 214:services/crypto/jitter_rng.c ****             return JITTER_ERR_INIT;
 215:services/crypto/jitter_rng.c ****         }
 216:services/crypto/jitter_rng.c ****     }
 217:services/crypto/jitter_rng.c **** 
 218:services/crypto/jitter_rng.c ****     /* RTC clock = LSI. RTCSEL can only be written once until a backup-domain
 219:services/crypto/jitter_rng.c ****      * reset, so if something else already chose a source we stop. */
 220:services/crypto/jitter_rng.c ****     {
