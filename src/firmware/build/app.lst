   9:Core/Src/app.c **** static void app_receive_serial_packet(void)
  10:Core/Src/app.c **** {
  11:Core/Src/app.c **** 	serial_packet_t *serial_packet;
  12:Core/Src/app.c **** 	packet_t radio_packet;
  13:Core/Src/app.c **** 
  14:Core/Src/app.c **** 	serial_process_buffer();
  15:Core/Src/app.c **** 	
  16:Core/Src/app.c **** 	if (serial_rxne())
  17:Core/Src/app.c **** 	{
  18:Core/Src/app.c **** 		serial_packet = serial_rx_queue_peak();
  19:Core/Src/app.c **** 
  20:Core/Src/app.c **** 		switch (serial_packet->type)
  21:Core/Src/app.c **** 		{
  22:Core/Src/app.c **** 		case SERIAL_PACKET_TYPE_MESSAGE:
  23:Core/Src/app.c **** 			radio_packet.type = PACKET_TYPE_MESSAGE;
  24:Core/Src/app.c **** 			radio_packet.message.ciphertext_length = serial_packet->message.length;
  25:Core/Src/app.c **** 			for (uint8_t i = 0;i < serial_packet->message.length;i++)
  26:Core/Src/app.c **** 			{
  27:Core/Src/app.c **** 				radio_packet.message.ciphertext[i] = serial_packet->message.data[i];
  28:Core/Src/app.c **** 			}
  29:Core/Src/app.c **** 			radio_queue_packet(&radio_packet);
  30:Core/Src/app.c **** 			break;
  31:Core/Src/app.c **** 		default:
  32:Core/Src/app.c **** 			break;
  33:Core/Src/app.c **** 		}
