   5:services/crypto/rng.c **** /*
   6:services/crypto/rng.c ****  * rng.c: AES-128 CTR_DRBG (NIST SP 800-90A Rev.1, no derivation function)
   7:services/crypto/rng.c ****  *
   8:services/crypto/rng.c ****  * Entropy input: jitter_rng_fill(seed, 32). That is already conditioned
   9:services/crypto/rng.c ****  * (AES-CBC-MAC), so it is used directly as the 256-bit seed (seedlen = 256
  10:services/crypto/rng.c ****  * for AES-128 without df).
  11:services/crypto/rng.c ****  *
  12:services/crypto/rng.c ****  * State: Key (16), V (16), reseed counter. About 40 bytes of RAM.
  13:services/crypto/rng.c ****  */
  14:services/crypto/rng.c **** 
  15:services/crypto/rng.c **** #define RNG_SEEDLEN          32u
  16:services/crypto/rng.c **** #define RNG_RESEED_INTERVAL  256u   /* generate calls between automatic reseeds */
